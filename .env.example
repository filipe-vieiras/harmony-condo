# Template de variáveis para o Vercel (copie os nomes das vars, não os valores!)
# Configure os valores reais no painel: https://vercel.com/[seu-projeto]/settings/environment-variables
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# URL pública do site, usada nos links de convite e de redefinição de senha.
# Em produção é https://app.donawanda.com.br. Se ausente, o app usa o endereço acessado.
# Em staging/preview pode ficar vazia.
# SITE_URL=https://app.donawanda.com.br
